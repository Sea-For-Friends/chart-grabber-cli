BasedOnStyle: LLVM
Standard: c++20
IndentWidth: 4
ColumnLimit: 110
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
BreakBeforeBraces: Attach
PointerAlignment: Left
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"cg/'
    Priority: 1
  - Regex: '^<Q'
    Priority: 2
  - Regex: '^<(gtest|gmock|sqlite3|zstd|brotli|png|jpeglib|tiffio)'
    Priority: 3
  - Regex: '^<'
    Priority: 4
