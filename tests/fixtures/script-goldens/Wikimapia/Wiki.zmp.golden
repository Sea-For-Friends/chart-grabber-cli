; T-0015D golden: Wikimapia/Wiki.zmp - RoundEx precision 5 on lon/lat, bbox order L,B,R,T.
; ResultURL := GetURLBase+RoundEx(GetLLon,5)+','+RoundEx(GetBLat,5)+','+RoundEx(GetRLon,5)+
;   ','+RoundEx(GetTLat,5)
; RoundEx(v,Digits) = FloatToStrF(v,ffFixed,Precision:=15,Digits) (spec F25): round v to
; min(Digits, 15-<int-digit-count>) decimals, half-away-from-zero, then zero-pad the display
; to exactly Digits decimals. Here every |v|<=180 has <=3 integer digits, so
; 15-3=12 > 5 = Digits: a plain round-half-away-from-zero to 5 decimals, no padding visible.

[P1]
GetX=0
GetY=0
GetZ=1
GetURLBase=http://wikimapia.org/d?lng=1&BBOX=
Version=
Lang=en
GetLLon=0xc066800000000000
GetTLat=0x40554345b1a549d7
GetRLon=0x4066800000000000
GetBLat=0xc0554345b1a549d7
GetLMetr=0xc1731bf8457c1093
GetTMetr=0x41731bf8457c1093
GetRMetr=0x41731bf8457c1093
GetBMetr=0xc1731bf8457c1096
RequestHead=
