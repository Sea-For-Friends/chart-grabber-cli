; T-0015D golden: mapservices.com.ua.map.zmp - IntToHex (8 digits, upper-case) + chained
; else-if with NO final else: outside [0,12] for (GetZ-6), ResultURL is never assigned and
; stays '' (buildRequest clears it before the run) - a normal 'tile does not exist' outcome.
; zz := GetZ-6
;  0<=zz<=9:  ResultURL := B+'0'+IntToStr(zz)+'/R'+IntToHex(GetY,8)+'/C'+IntToHex(GetX,8)+'.png'
;  10<=zz<=12: ResultURL := B+IntToStr(zz)+'/R'+IntToHex(GetY,8)+'/C'+IntToHex(GetX,8)+'.png'
;  else: unset (empty ResultURL)
; P1 (zz=-5), P2 (zz=-4): no branch matches -> tile does not exist.
; P3 (zz=8): IntToHex(5678,8)='0000162E'; IntToHex(1234,8)='000004D2'.
; P4 (zz=12): IntToHex(87654,8)='00015666'; IntToHex(131071,8)='0001FFFF'.

[P1]
; tile does not exist: zz=-5 matches neither branch.
