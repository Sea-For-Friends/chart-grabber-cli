; T-0015D golden: geoportal.md.cadastre.zmp - round(IntPower(2,GetZ-1)) with a flipped Y
; and a NEGATIVE zoom at P1 (GetZ-3 = -2), emitted literally by IntToStr - a defect in this
; corpus map script itself (not SAS.Planet code, not the port), reproduced verbatim per the
; port's 1:1 rule; see docs/parity/map-corpus-defects.md.
; ResultURL := GetURLBase+IntToStr(GetZ-3)+'/'+IntToStr(GetX)+'/'+
;   IntToStr(Round(IntPower(2,GetZ-1)-GetY-1))+'.png'
; P1: IntPower(2,0)=1; Round(1-0-1)=0 -> '-2/0/0.png'.
; P3: IntPower(2,13)=8192; Round(8192-5678-1)=2513.
; P4: IntPower(2,17)=131072; Round(131072-87654-1)=43417.

[P1]
; legacy defect: negative zoom '-2' kept literal, not clamped - keep the golden.
GetX=0
GetY=0
GetZ=1
GetURLBase=http://geoportal.md/tiles/_base6/
Version=
Lang=en
GetLLon=0xc066800000000000
GetTLat=0x40554345b1a549d7
GetRLon=0x4066800000000000
GetBLat=0xc0554345b1a549d7
GetLMetr=0xc1731bf8457c1093
GetTMetr=0x41731bf8457c1093
GetRMetr=0x41731bf8457c1093
GetBMetr=0xc1731bf8457c1096
RequestHead=
ResultURL=http://geoportal.md/tiles/_base6/-2/0/0.png
PostData=

