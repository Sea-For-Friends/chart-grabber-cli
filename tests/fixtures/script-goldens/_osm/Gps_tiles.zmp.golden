; T-0015D golden: _osm/Gps_tiles.zmp - leading-slash concatenation (GetURLBase already ends
; in '/', script prepends another '/' -> '//' in the URL, kept verbatim).
; ResultURL := GetURLBase+'/'+IntToStr(GetZ-1)+'/'+IntToStr(GetX)+'/'+IntToStr(GetY)+'.png'
; RequestHead is pre-filled from params.txt and never touched by the script.

[P1]
GetX=0
GetY=0
GetZ=1
GetURLBase=https://gps.tile.openstreetmap.org/lines/
Version=
Lang=en
GetLLon=0xc066800000000000
GetTLat=0x40554345b1a549d7
GetRLon=0x4066800000000000
GetBLat=0xc0554345b1a549d7
GetLMetr=0xc1731bf8457c1093
GetTMetr=0x41731bf8457c1093
GetRMetr=0x41731bf8457c1093
GetBMetr=0xc1731bf8457c1096
RequestHead=Referer: http://www.openstreetmap.org/
ResultURL=https://gps.tile.openstreetmap.org/lines//0/0/0.png
PostData=

